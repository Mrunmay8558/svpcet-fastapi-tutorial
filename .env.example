# ---------------------------------------------------------------------------
# Environment template
#
# Copy this file to .env and fill in the values for your own machine:
#     cp .env.example .env
#
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Local install:  mongodb://localhost:27017
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Used by: core/database/database.py
MONGODB_URL=mongodb://localhost:27017

# Name of the MongoDB database this application reads and writes.
# Used by: core/database/database.py
DATABASE_NAME=your_database_name

# ---------------------------------------------------------------------------
# JWT settings — used by commons/auth.py
# ---------------------------------------------------------------------------

# Secret key used to sign and verify JWT access tokens.
# Generate a strong random value, e.g.:
#     python -c "import secrets; print(secrets.token_hex(32))"
secret=replace_with_a_long_random_secret

# Algorithm used to sign JWT access tokens.
algorithm=HS256
